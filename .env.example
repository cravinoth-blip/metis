# Copy this file to .env and fill in values before running in production.
# docker-compose will automatically load .env from this directory.

# Required: generate with `openssl rand -hex 32`
SECRET_KEY=replace-this-with-a-long-random-string-at-least-32-chars

# Optional — token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to true when running behind HTTPS (marks cookies Secure)
# Must be true on Vercel — the deployment is always HTTPS
SECURE_COOKIES=false

# Database (defaults to SQLite; set a postgres:// URL for production)
# DATABASE_URL=postgresql://user:password@host/dbname

# CORS allowed origins
# FRONTEND_URL=https://your-frontend.example.com
# VERCEL_URL=your-project.vercel.app
